APP_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://username:password@hostname:5432/database_name
APP_BASE_URL=https://your-app.onrender.com

INSTITUTE_NAME=MIT Letterbox System
DEPARTMENT_TITLE=Department of Electronics Engineering
CAMPUS_TITLE=MIT Campus - Anna University
CITY_TITLE=Chennai
LETTER_HEADING=Dept of Electronics Engineering
INSTITUTE_EMAIL_DOMAINS=mit.edu,mitindia.edu

ALLOW_STUDENT_SELF_SIGNUP=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
LOG_LEVEL=INFO
SESSION_IDLE_MINUTES=5

INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Institute Admin
INITIAL_ADMIN_EMAIL=

INITIAL_STAFF_USERNAME=officeadmin
INITIAL_STAFF_PASSWORD=ChangeThisImmediately123!
INITIAL_STAFF_NAME=Institute Staff
INITIAL_STAFF_EMAIL=officeadmin@mit.edu
ADMIN_ACCESS_KEY=replace-with-a-separate-staff-key

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Mailjet v3.1 transactional email API. The sender must be verified in Mailjet.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_SENDER_EMAIL=no-reply@your-verified-domain.example
MAILJET_TIMEOUT=15

# Optional SMS notifications using Twilio. Leave disabled unless all values are set.
SMS_ENABLED=false
SMS_DEFAULT_COUNTRY_CODE=+91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

ESP_TOKEN=replace-with-a-long-random-device-token
ESP32_HOST=

AI_OLLAMA_URL=http://localhost:11434/api/generate
AI_MODEL=qwen2.5:1.5b-instruct
AI_TIMEOUT=45
AI_MAX_BODY_LENGTH=1000
